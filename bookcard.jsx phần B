function BookCard({ book, isFav, onToggleFav }) {
  return (
    <article className="book-card">
      <h3>{book.title}</h3>
      <p>{book.author} - {book.category} ({book.year})</p>
      <button onClick={() => onToggleFav(book.id)}>
        {isFav ? 'Bỏ Yêu thích' : 'Yêu thích'}
      </button>
    </article>
  )
}
export default BookCard;
