* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: Arial, sans-serif; padding: 20px; background: #f4f4f4; }
.header { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 2px solid #ccc; margin-bottom: 20px;}
.toolbar, .form-section { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
.input-group { display: flex; flex-direction: column; gap: 5px; }
.error { color: red; font-size: 12px; }

/* Responsive Grid cho sách */
.book-list { 
    display: flex; 
    flex-wrap: wrap; 
    gap: 20px; 
}
.book-card {
    background: white; padding: 15px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    flex: 1 1 calc(33.333% - 20px); 
}

@media (max-width: 768px) {
    .book-card { flex: 1 1 100%; }
}
